# Production Environment Variables — LivingLink
# Copy to .env.production and fill in real values before deploying.
# NEVER commit .env.production to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://livinglink.health

# ─── Clerk Authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/donor/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/consent

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/livinglink?sslmode=require
DIRECT_URL=postgresql://user:password@host/livinglink?sslmode=require

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── FHIR (HAPI FHIR R4 — Railway) ────────────────────────────────────────────
HAPI_FHIR_BASE_URL=https://hapi-fhir.railway.app/fhir
FHIR_SERVER_URL=https://hapi-fhir.railway.app/fhir
FHIR_SERVER_TOKEN=replace-with-managed-service-token
FHIR_WRITE_ENABLED=false

# ─── SMART on FHIR (optional — EHR integration) ──────────────────────────────
SMART_CLIENT_ID=livinglink
SMART_CLIENT_SECRET=...
SMART_REDIRECT_URI=https://livinglink.health/api/fhir/smart/callback
SMART_ALLOWED_ISSUERS=https://your-ehr.example/fhir

# ─── CDS Hooks ────────────────────────────────────────────────────────────────
CDS_HOOKS_BEARER_TOKEN=replace-with-managed-service-token

# ─── Encryption ───────────────────────────────────────────────────────────────
PHI_ENCRYPTION_KEY=replace-with-managed-32-byte-key
ALLOW_PHI_TO_AI=false
