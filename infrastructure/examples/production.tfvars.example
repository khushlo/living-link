aws_region        = "us-east-1"
environment       = "production"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

public_subnet_cidrs       = ["10.40.0.0/24", "10.40.1.0/24", "10.40.2.0/24"]
private_app_subnet_cidrs  = ["10.40.10.0/24", "10.40.11.0/24", "10.40.12.0/24"]
private_data_subnet_cidrs = ["10.40.20.0/24", "10.40.21.0/24", "10.40.22.0/24"]

# Pin deployment images by digest after vulnerability scanning and approval.
app_image  = "111122223333.dkr.ecr.us-east-1.amazonaws.com/kidneyx-app@sha256:REPLACE"
fhir_image = "111122223333.dkr.ecr.us-east-1.amazonaws.com/kidneyx-fhir@sha256:REPLACE"

public_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/REPLACE"
fhir_certificate_arn   = "arn:aws:acm:us-east-1:111122223333:certificate/REPLACE"

# References only. Create secret values out of band; never commit them.
app_secret_arns = {
  AUTH_SECRET = "arn:aws:secretsmanager:us-east-1:111122223333:secret:REPLACE"
}

fhir_secret_arns = {}
alarm_email       = "security-operations@example.org"
allowed_ipv4_cidrs = ["203.0.113.0/24"]

tags = {
  Owner      = "platform-security"
  CostCenter = "REPLACE"
}
