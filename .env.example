# =============================================================
# LivingLink Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# ---- Auth (Clerk) -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---- Database -----------------------------------------------
DATABASE_URL=postgresql://livinglink:livinglink_dev_password@localhost:5432/livinglink

# ---- FHIR Server --------------------------------------------
FHIR_SERVER_URL=http://localhost:8080/fhir
SMART_CLIENT_ID=livinglink-app
SMART_REDIRECT_URI=http://localhost:3000/api/fhir/callback

# ---- OpenAI -------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- AWS S3 (file uploads - receipts, documents) ------------
AWS_S3_BUCKET=livinglink-uploads-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- App ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
