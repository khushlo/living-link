# =============================================================
# LivingLink Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# ---- Auth (Clerk) -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---- Database -----------------------------------------------
DATABASE_URL=postgresql://livinglink:livinglink_dev_password@localhost:5432/livinglink
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENCRYPTION_KEY=
# Production: retain prior versions for decryption during rotation, for example:
# PHI_ENCRYPTION_KEYS=v1:base64-old-key,v2:base64-new-key
# PHI_ENCRYPTION_ACTIVE_KEY_VERSION=v2
PHI_ENCRYPTION_KEYS=
PHI_ENCRYPTION_ACTIVE_KEY_VERSION=v1

# ---- FHIR Server --------------------------------------------
FHIR_SERVER_URL=http://localhost:8080/fhir
FHIR_SERVER_TOKEN=
FHIR_WRITE_ENABLED=false
SMART_CLIENT_ID=livinglink-app
SMART_REDIRECT_URI=http://localhost:3000/api/fhir/smart/callback
SMART_ALLOWED_ISSUERS=http://localhost:8080/fhir

# ---- OpenAI -------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Default false: authenticated health metrics and chat must not be sent to AI
# until vendor terms, BAA/DPA, and pilot approval are documented.
ALLOW_PHI_TO_AI=false

# ---- CDS Hooks ------------------------------------------------
# Required before enabling a CDS Hooks service that can return patient-associated information.
CDS_HOOKS_BEARER_TOKEN=

# ---- AWS S3 (file uploads - receipts, documents) ------------
AWS_S3_BUCKET=livinglink-uploads-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- App ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
