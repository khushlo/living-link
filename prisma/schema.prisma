// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  DONOR
  PATIENT
  COORDINATOR
  CLINICIAN
  ADMIN
}

enum DonationStatus {
  EXPLORING
  IN_EVALUATION
  APPROVED
  DONATED
  DECLINED
}

enum GoalMetric {
  BMI
  BLOOD_PRESSURE
  SMOKING
  BLOOD_SUGAR
  WEIGHT
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum EvaluationStage {
  INITIAL_INQUIRY
  BLOODWORK
  IMAGING
  CARDIAC_EVAL
  PSYCH_EVAL
  FINAL_REVIEW
  APPROVED
  DECLINED
}

enum CheckinWeek {
  WEEK_2
  MONTH_1
  MONTH_3
  MONTH_6
  YEAR_1
  YEAR_2_PLUS
}

enum FocusArea {
  PUBLIC_AWARENESS
  DONOR_READINESS
  DONOR_INTERVENTIONS
  CENTER_PRACTICES
  DONOR_OUTCOMES
}

// ─── CORE USER ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  clerkId         String    @unique @map("clerk_id")
  email           String    @unique
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  role            UserRole  @default(DONOR)
  preferredLang   String    @default("en") @map("preferred_lang")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  donorProfile      DonorProfile?
  mentorProfile     MentorProfile?
  mentorMatches     MentorMatch[]   @relation("CandidateMatches")
  mentorOf          MentorMatch[]   @relation("MentorMatches")
  sentMessages      Message[]       @relation("SentMessages")
  notifications     Notification[]
  forumPosts        ForumPost[]
  auditLogs         AuditLog[]
  center            CenterMembership?

  @@map("users")
}

// ─── DONOR MODULES ────────────────────────────────────────────────────────────

model DonorProfile {
  id                String          @id @default(uuid())
  userId            String          @unique @map("user_id")
  donationStatus    DonationStatus  @default(EXPLORING)
  isParentDonor     Boolean         @default(false) @map("is_parent_donor")
  donatedAt         DateTime?       @map("donated_at")
  recipientRelation String?         @map("recipient_relation")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id])
  eligibilityChecks EligibilityCheck[]
  healthGoals       HealthGoal[]
  financialRecords  FinancialRecord[]
  checkins          PostDonationCheckin[]
  phq2Responses     PHQ2Response[]
  fhirPatientId     String?           @map("fhir_patient_id")

  @@map("donor_profiles")
}

model EligibilityCheck {
  id            String   @id @default(uuid())
  donorProfileId String   @map("donor_profile_id")
  bmi           Float?
  bpSystolic    Int?     @map("bp_systolic")
  bpDiastolic   Int?     @map("bp_diastolic")
  egfr          Float?
  smokingStatus String?  @map("smoking_status") // never, former, current
  hasDiabetes   Boolean? @map("has_diabetes")
  age           Int?
  aiSummary     String?  @map("ai_summary")   // AI-generated readiness summary
  assessedAt    DateTime @default(now()) @map("assessed_at")

  donorProfile  DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("eligibility_checks")
}

model HealthGoal {
  id             String     @id @default(uuid())
  donorProfileId String     @map("donor_profile_id")
  metric         GoalMetric
  targetValue    Float      @map("target_value")
  currentValue   Float?     @map("current_value")
  targetDate     DateTime?  @map("target_date")
  status         GoalStatus @default(ACTIVE)
  aiCoachNote    String?    @map("ai_coach_note")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])
  progressLogs   GoalProgressLog[]

  @@map("health_goals")
}

model GoalProgressLog {
  id         String    @id @default(uuid())
  goalId     String    @map("goal_id")
  value      Float
  note       String?
  loggedAt   DateTime  @default(now()) @map("logged_at")

  goal       HealthGoal @relation(fields: [goalId], references: [id])

  @@map("goal_progress_logs")
}

// ─── DONOR SHIELD (Financial) ─────────────────────────────────────────────────

model FinancialRecord {
  id                String    @id @default(uuid())
  donorProfileId    String    @map("donor_profile_id")
  itemType          String    @map("item_type") // travel, lodging, childcare, medical, lost_wage
  description       String?
  amount            Float
  receiptS3Key      String?   @map("receipt_s3_key")
  isReimbursed      Boolean   @default(false) @map("is_reimbursed")
  reimbursedAmount  Float?    @map("reimbursed_amount")
  createdAt         DateTime  @default(now()) @map("created_at")

  donorProfile      DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("financial_records")
}

// ─── MENTOR MATCH ─────────────────────────────────────────────────────────────

model MentorProfile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  donationYear    Int?      @map("donation_year")
  donationTypes   String[]  @map("donation_types")  // directed, paired, altruistic
  languages       String[]  @default(["en"])
  specialties     String[]  // financial barriers, parenting, anxiety, etc.
  bio             String?
  isVerified      Boolean   @default(false) @map("is_verified")
  isAvailable     Boolean   @default(true) @map("is_available")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User @relation(fields: [userId], references: [id])

  @@map("mentor_profiles")
}

model MentorMatch {
  id            String    @id @default(uuid())
  candidateId   String    @map("candidate_id")
  mentorId      String    @map("mentor_id")
  matchScore    Float?    @map("match_score")
  status        String    @default("pending") // pending, active, completed
  matchedAt     DateTime  @default(now()) @map("matched_at")

  candidate     User @relation("CandidateMatches", fields: [candidateId], references: [id])
  mentor        User @relation("MentorMatches", fields: [mentorId], references: [id])
  thread        MessageThread?

  @@map("mentor_matches")
}

model MessageThread {
  id            String    @id @default(uuid())
  matchId       String    @unique @map("match_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  match         MentorMatch @relation(fields: [matchId], references: [id])
  messages      Message[]

  @@map("message_threads")
}

model Message {
  id          String        @id @default(uuid())
  threadId    String        @map("thread_id")
  senderId    String        @map("sender_id")
  content     String        // encrypted at app layer before storing
  status      MessageStatus @default(SENT)
  sentAt      DateTime      @default(now()) @map("sent_at")
  readAt      DateTime?     @map("read_at")

  thread      MessageThread @relation(fields: [threadId], references: [id])
  sender      User          @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

// ─── CENTER FLOW ──────────────────────────────────────────────────────────────

model TransplantCenter {
  id          String   @id @default(uuid())
  name        String
  city        String
  state       String
  optnId      String?  @unique @map("optn_id")
  fhirOrgId   String?  @map("fhir_org_id")
  createdAt   DateTime @default(now()) @map("created_at")

  members     CenterMembership[]
  protocols   Protocol[]
  evaluations DonorEvaluation[]

  @@map("transplant_centers")
}

model CenterMembership {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  centerId  String   @map("center_id")
  role      String   // coordinator, clinician
  joinedAt  DateTime @default(now()) @map("joined_at")

  user      User             @relation(fields: [userId], references: [id])
  center    TransplantCenter @relation(fields: [centerId], references: [id])

  @@map("center_memberships")
}

model Protocol {
  id          String    @id @default(uuid())
  centerId    String?   @map("center_id")  // null = shared/public
  focusArea   FocusArea @map("focus_area")
  title       String
  content     String
  tags        String[]
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  center      TransplantCenter? @relation(fields: [centerId], references: [id])

  @@map("protocols")
}

model DonorEvaluation {
  id           String          @id @default(uuid())
  centerId     String          @map("center_id")
  donorRef     String          @map("donor_ref")  // de-identified reference
  stage        EvaluationStage @default(INITIAL_INQUIRY)
  stageHistory Json            @default("[]") @map("stage_history")
  daysElapsed  Int             @default(0) @map("days_elapsed")
  isStalled    Boolean         @default(false) @map("is_stalled")
  notes        String?
  startedAt    DateTime        @default(now()) @map("started_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  center       TransplantCenter @relation(fields: [centerId], references: [id])

  @@map("donor_evaluations")
}

// ─── LIFE AFTER (Post-Donation) ───────────────────────────────────────────────

model PostDonationCheckin {
  id             String      @id @default(uuid())
  donorProfileId String      @map("donor_profile_id")
  week           CheckinWeek
  bpSystolic     Int?        @map("bp_systolic")
  bpDiastolic    Int?        @map("bp_diastolic")
  weightKg       Float?      @map("weight_kg")
  moodScore      Int?        @map("mood_score")   // 1-10
  energyScore    Int?        @map("energy_score") // 1-10
  notes          String?     // encrypted at app layer
  completedAt    DateTime    @default(now()) @map("completed_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("post_donation_checkins")
}

model PHQ2Response {
  id             String   @id @default(uuid())
  donorProfileId String   @map("donor_profile_id")
  q1Score        Int      @map("q1_score")  // 0-3
  q2Score        Int      @map("q2_score")  // 0-3
  totalScore     Int      @map("total_score")
  isEscalated    Boolean  @default(false) @map("is_escalated")
  completedAt    DateTime @default(now()) @map("completed_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("phq2_responses")
}

// ─── SHARED ───────────────────────────────────────────────────────────────────

model ForumPost {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  category  String
  title     String
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author    User @relation(fields: [authorId], references: [id])

  @@map("forum_posts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    // checkin_due, stalled_eval, message_received, goal_milestone
  title     String
  body      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── AUDIT LOG (append-only) ──────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String   // READ, CREATE, UPDATE, DELETE
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json     @default("{}")
  timestamp    DateTime @default(now())

  user         User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
