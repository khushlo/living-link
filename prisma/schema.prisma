// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  DONOR
  PATIENT
  COORDINATOR
  CLINICIAN
  ADMIN
}

enum SmartLaunchType {
  EHR
  STANDALONE
}

enum DonationStatus {
  EXPLORING
  IN_EVALUATION
  APPROVED
  DONATED
  DECLINED
}

enum GoalMetric {
  BMI
  BLOOD_PRESSURE
  SMOKING
  BLOOD_SUGAR
  WEIGHT
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum EvaluationStage {
  INITIAL_INQUIRY
  BLOODWORK
  IMAGING
  CARDIAC_EVAL
  PSYCH_EVAL
  FINAL_REVIEW
  APPROVED
  DECLINED
}

enum CheckinWeek {
  WEEK_2
  MONTH_1
  MONTH_3
  MONTH_6
  YEAR_1
  YEAR_2_PLUS
}

enum FocusArea {
  PUBLIC_AWARENESS
  DONOR_READINESS
  DONOR_INTERVENTIONS
  CENTER_PRACTICES
  DONOR_OUTCOMES
}

// ─── CORE USER ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  clerkId         String    @unique @map("clerk_id")
  email           String    @unique
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  phone           String?
  role            UserRole  @default(DONOR)
  preferredLang   String    @default("en") @map("preferred_lang")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  donorProfile      DonorProfile?
  mentorProfile     MentorProfile?
  mentorMatches     MentorMatch[]   @relation("CandidateMatches")
  mentorOf          MentorMatch[]   @relation("MentorMatches")
  sentMessages      Message[]       @relation("SentMessages")
  notifications     Notification[]
  forumPosts        ForumPost[]
  auditLogs         AuditLog[]
  deletionRequests  DataDeletionRequest[]
  mentorReports     MentorSafetyReport[]
  storySubmissions  StorySubmission[]
  center            CenterMembership?
  smartSessions     SmartSession[]
  reviewedEhrRegistrations EHRRegistration[] @relation("EHRRegistrationReviewer")

  @@map("users")
}

// ─── DONOR MODULES ────────────────────────────────────────────────────────────

model DonorProfile {
  id                String          @id @default(uuid())
  userId            String          @unique @map("user_id")
  donationStatus    DonationStatus  @default(EXPLORING)
  isParentDonor     Boolean         @default(false) @map("is_parent_donor")
  donatedAt         DateTime?       @map("donated_at")
  dateOfBirth       DateTime?       @map("date_of_birth")
  donationType      String?         @map("donation_type")
  recipientRelation String?         @map("recipient_relation")
  transplantCenterName String?      @map("transplant_center_name")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id])
  eligibilityChecks EligibilityCheck[]
  healthGoals       HealthGoal[]
  financialRecords  FinancialRecord[]
  nldacApplications NLDACApplication[]
  lifeAfterReminders LifeAfterReminder[]
  insuranceIssues   InsuranceIssue[]
  checkins          PostDonationCheckin[]
  phq2Responses     PHQ2Response[]
  consentRecords    ConsentRecord[]
  centerAuthorizations DonorCenterAuthorization[]
  externalPatientMappings ExternalPatientMapping[]
  fhirPatientId     String?           @map("fhir_patient_id")
  consentedAt       DateTime?         @map("consented_at")
  consentVersion    String?           @map("consent_version")
  researchConsent   Boolean           @default(false) @map("research_consent")

  @@map("donor_profiles")
}

model ConsentRecord {
  id             String    @id @default(uuid())
  donorProfileId String    @map("donor_profile_id")
  purpose        String
  version        String
  granted        Boolean   @default(false)
  grantedAt      DateTime? @map("granted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@index([donorProfileId, purpose, createdAt])
  @@map("consent_records")
}

model SmartSession {
  id                   String    @id @default(uuid())
  state                String    @unique
  issuer               String
  connectionId         String?              @map("connection_id")
  launchType           SmartLaunchType      @default(EHR) @map("launch_type")
  localUserId          String?              @map("local_user_id")
  localCenterId        String?              @map("local_center_id")
  authorizedPatientContext String?          @map("authorized_patient_context")
  grantedScopes        String[]             @default([]) @map("granted_scopes")
  tokenMetadata        Json                 @default("{}") @map("token_metadata")
  tokenEndpoint        String    @map("token_endpoint")
  pkceVerifier         String    @map("pkce_verifier")
  accessTokenEncrypted String?   @map("access_token_encrypted")
  patientIdEncrypted   String?   @map("patient_id_encrypted")
  expiresAt            DateTime  @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  consumedAt           DateTime? @map("consumed_at")

  connection            EHRConnection? @relation(fields: [connectionId], references: [id])
  localUser             User? @relation(fields: [localUserId], references: [id])

  @@map("smart_sessions")
}

model EHRConnection {
  id                     String   @id @default(uuid())
  issuer                 String
  vendor                 String
  environment            String
  organizationCenterId   String?  @map("organization_center_id")
  enabled                Boolean  @default(true)
  smartClientId          String?  @map("smart_client_id")
  clientConfigurationRef String?  @map("client_configuration_ref")
  allowedCapabilities    Json     @default("[]") @map("allowed_capabilities")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  center                  TransplantCenter? @relation(fields: [organizationCenterId], references: [id])
  smartSessions           SmartSession[]
  externalPatientMappings ExternalPatientMapping[]
  registration             EHRRegistration?

  @@unique([issuer, environment])
  @@index([organizationCenterId, enabled])
  @@map("ehr_connections")
}

model EHRRegistration {
  id                     String    @id @default(uuid())
  organizationName       String    @map("organization_name")
  organizationWebsite    String?   @map("organization_website")
  contactName             String    @map("contact_name")
  contactEmail            String    @map("contact_email")
  contactPhone            String?   @map("contact_phone")
  vendor                  String
  productName             String    @map("product_name")
  environment             String
  fhirIssuer              String    @map("fhir_issuer")
  fhirVersion             String    @default("R4") @map("fhir_version")
  smartSupported          Boolean   @default(false) @map("smart_supported")
  smartClientId           String?   @map("smart_client_id")
  cdsHooksSupported       Boolean   @default(false) @map("cds_hooks_supported")
  requestedScopes         String[]  @default([]) @map("requested_scopes")
  notes                   String?
  approved                Boolean   @default(false)
  approvedAt              DateTime? @map("approved_at")
  rejectedAt              DateTime? @map("rejected_at")
  rejectionReason         String?   @map("rejection_reason")
  reviewedAt              DateTime? @map("reviewed_at")
  reviewedById            String?   @map("reviewed_by_id")
  ehrConnectionId         String?   @unique @map("ehr_connection_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  reviewedBy    User?          @relation("EHRRegistrationReviewer", fields: [reviewedById], references: [id])
  ehrConnection EHRConnection? @relation(fields: [ehrConnectionId], references: [id])

  @@index([approved, rejectedAt, createdAt])
  @@index([fhirIssuer, environment])
  @@map("ehr_registrations")
}

model ContactInquiry {
  id             String   @id @default(uuid())
  name           String
  organization   String
  email          String
  phone          String?
  inquiryType    String   @map("inquiry_type")
  message        String
  status         String   @default("NEW")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

model ExternalPatientMapping {
  id                String   @id @default(uuid())
  connectionId      String   @map("connection_id")
  donorProfileId    String   @map("donor_profile_id")
  externalPatientId String   @map("external_patient_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  connection   EHRConnection @relation(fields: [connectionId], references: [id])
  donorProfile DonorProfile   @relation(fields: [donorProfileId], references: [id])

  @@unique([connectionId, externalPatientId])
  @@unique([connectionId, donorProfileId])
  @@map("external_patient_mappings")
}

model EligibilityCheck {
  id            String   @id @default(uuid())
  donorProfileId String   @map("donor_profile_id")
  bmi           Float?
  bpSystolic    Int?     @map("bp_systolic")
  bpDiastolic   Int?     @map("bp_diastolic")
  egfr          Float?
  smokingStatus String?  @map("smoking_status") // never, former, current
  hasDiabetes   Boolean? @map("has_diabetes")
  age           Int?
  aiSummary     String?  @map("ai_summary")   // AI-generated readiness summary
  assessedAt    DateTime @default(now()) @map("assessed_at")

  donorProfile  DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("eligibility_checks")
}

model HealthGoal {
  id             String     @id @default(uuid())
  donorProfileId String     @map("donor_profile_id")
  metric         GoalMetric
  targetValue    Float      @map("target_value")
  currentValue   Float?     @map("current_value")
  targetDate     DateTime?  @map("target_date")
  status         GoalStatus @default(ACTIVE)
  aiCoachNote    String?    @map("ai_coach_note")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])
  progressLogs   GoalProgressLog[]

  @@unique([donorProfileId, metric])
  @@map("health_goals")
}

model GoalProgressLog {
  id         String    @id @default(uuid())
  goalId     String    @map("goal_id")
  value      Float
  note       String?
  loggedAt   DateTime  @default(now()) @map("logged_at")

  goal       HealthGoal @relation(fields: [goalId], references: [id])

  @@map("goal_progress_logs")
}

// ─── DONOR SHIELD (Financial) ─────────────────────────────────────────────────

model FinancialRecord {
  id                String    @id @default(uuid())
  donorProfileId    String    @map("donor_profile_id")
  itemType          String    @map("item_type") // travel, lodging, childcare, medical, lost_wage
  description       String?
  amount            Float
  receiptS3Key      String?   @map("receipt_s3_key")
  isReimbursed      Boolean   @default(false) @map("is_reimbursed")
  reimbursedAmount  Float?    @map("reimbursed_amount")
  reimbursementStatus String  @default("not_submitted") @map("reimbursement_status")
  reimbursementNotes String? @map("reimbursement_notes")
  createdAt         DateTime  @default(now()) @map("created_at")

  donorProfile      DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@map("financial_records")
}

model NLDACApplication {
  id              String    @id @default(uuid())
  donorProfileId  String    @map("donor_profile_id")
  status          String    @default("draft")
  employmentType  String?   @map("employment_type")
  isUSResident    Boolean?  @map("is_us_resident")
  hasSurgeryDate  Boolean?  @map("has_surgery_date")
  grossIncome     Float?    @map("gross_income")
  centerConfirmed Boolean   @default(false) @map("center_confirmed")
  applicationRef  String?   @map("application_ref")
  submittedAt     DateTime? @map("submitted_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id])
  @@index([donorProfileId, updatedAt])
  @@map("nldac_applications")
}

model InsuranceIssue {
  id             String   @id @default(uuid())
  donorProfileId String   @map("donor_profile_id")
  type           String
  description    String
  status         String   @default("open") // open, in_progress, escalated, resolved
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@index([donorProfileId, createdAt])
  @@map("insurance_issues")
}

// ─── MENTOR MATCH ─────────────────────────────────────────────────────────────

model MentorProfile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  donationYear    Int?      @map("donation_year")
  donationTypes   String[]  @map("donation_types")  // directed, paired, altruistic
  languages       String[]  @default(["en"])
  specialties     String[]  // financial barriers, parenting, anxiety, etc.
  bio             String?
  isVerified      Boolean   @default(false) @map("is_verified")
  isAvailable     Boolean   @default(true) @map("is_available")
  trainingAcknowledgedAt DateTime? @map("training_acknowledged_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User @relation(fields: [userId], references: [id])

  @@map("mentor_profiles")
}

model DataDeletionRequest {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  status       String    @default("OPEN") // OPEN, UNDER_REVIEW, FAILED, COMPLETED, DENIED
  requestedAt  DateTime  @default(now()) @map("requested_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  reason       String?
  anonymizationAttemptedAt DateTime? @map("anonymization_attempted_at")
  failureStep  String?   @map("failure_step")
  failureMessage String? @map("failure_message")
  evidencePseudonym String? @map("evidence_pseudonym")

  user         User @relation(fields: [userId], references: [id])

  @@map("data_deletion_requests")
}

model MentorMatch {
  id            String    @id @default(uuid())
  candidateId   String    @map("candidate_id")
  mentorId      String    @map("mentor_id")
  matchScore    Float?    @map("match_score")
  status        String    @default("pending") // pending, active, completed
  matchedAt     DateTime  @default(now()) @map("matched_at")

  candidate     User @relation("CandidateMatches", fields: [candidateId], references: [id])
  mentor        User @relation("MentorMatches", fields: [mentorId], references: [id])
  thread        MessageThread?

  @@map("mentor_matches")
}

model MessageThread {
  id            String    @id @default(uuid())
  matchId       String    @unique @map("match_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  match         MentorMatch @relation(fields: [matchId], references: [id])
  messages      Message[]

  @@map("message_threads")
}

model Message {
  id          String        @id @default(uuid())
  threadId    String        @map("thread_id")
  senderId    String        @map("sender_id")
  content     String        // encrypted at app layer before storing
  status      MessageStatus @default(SENT)
  sentAt      DateTime      @default(now()) @map("sent_at")
  readAt      DateTime?     @map("read_at")

  thread      MessageThread @relation(fields: [threadId], references: [id])
  sender      User          @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model MentorSafetyReport {
  id           String    @id @default(uuid())
  reporterId   String    @map("reporter_id")
  messageId    String?   @map("message_id")
  category     String
  details      String?
  status       String    @default("OPEN") // OPEN, ACKNOWLEDGED, CLOSED
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")

  reporter     User @relation(fields: [reporterId], references: [id])

  @@map("mentor_safety_reports")
}

model StorySubmission {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  body         String
  donationType String   @map("donation_type")
  donationYear Int      @map("donation_year")
  status       String   @default("PENDING")
  consentedAt  DateTime @map("consented_at")
  createdAt    DateTime @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("story_submissions")
}

// ─── CENTER FLOW ──────────────────────────────────────────────────────────────

model TransplantCenter {
  id          String   @id @default(uuid())
  name        String
  city        String
  state       String
  optnId      String?  @unique @map("optn_id")
  fhirOrgId   String?  @map("fhir_org_id")
  createdAt   DateTime @default(now()) @map("created_at")

  members     CenterMembership[]
  protocols   Protocol[]
  evaluations DonorEvaluation[]
  donorAuthorizations DonorCenterAuthorization[]
  ehrConnections EHRConnection[]

  @@map("transplant_centers")
}

model CenterMembership {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  centerId  String   @map("center_id")
  role      String   // coordinator, clinician
  joinedAt  DateTime @default(now()) @map("joined_at")

  user      User             @relation(fields: [userId], references: [id])
  center    TransplantCenter @relation(fields: [centerId], references: [id])

  @@map("center_memberships")
}

model Protocol {
  id          String    @id @default(uuid())
  centerId    String?   @map("center_id")  // null = shared/public
  focusArea   FocusArea @map("focus_area")
  title       String
  content     String
  tags        String[]
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  center      TransplantCenter? @relation(fields: [centerId], references: [id])

  @@map("protocols")
}

model DonorEvaluation {
  id           String          @id @default(uuid())
  centerId     String          @map("center_id")
  donorRef     String          @map("donor_ref")  // de-identified reference
  stage        EvaluationStage @default(INITIAL_INQUIRY)
  stageHistory Json            @default("[]") @map("stage_history")
  daysElapsed  Int             @default(0) @map("days_elapsed")
  isStalled    Boolean         @default(false) @map("is_stalled")
  notes        String?
  startedAt    DateTime        @default(now()) @map("started_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  center       TransplantCenter @relation(fields: [centerId], references: [id])

  @@map("donor_evaluations")
}

// ─── LIFE AFTER (Post-Donation) ───────────────────────────────────────────────

model PostDonationCheckin {
  id             String      @id @default(uuid())
  donorProfileId String      @map("donor_profile_id")
  week           CheckinWeek
  bpSystolic     Int?        @map("bp_systolic")
  bpDiastolic    Int?        @map("bp_diastolic")
  weightKg       Float?      @map("weight_kg")
  moodScore      Int?        @map("mood_score")   // 1-10
  energyScore    Int?        @map("energy_score") // 1-10
  notes          String?     // encrypted at app layer
  completedAt    DateTime    @default(now()) @map("completed_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])

  @@unique([donorProfileId, week])
  @@map("post_donation_checkins")
}

model DonorCenterAuthorization {
  id             String    @id @default(uuid())
  donorProfileId String    @map("donor_profile_id")
  centerId       String    @map("center_id")
  grantedAt      DateTime  @map("granted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  donorProfile DonorProfile    @relation(fields: [donorProfileId], references: [id])
  center       TransplantCenter @relation(fields: [centerId], references: [id])

  @@unique([donorProfileId, centerId])
  @@index([centerId, revokedAt])
  @@map("donor_center_authorizations")
}

model PHQ2Response {
  id             String   @id @default(uuid())
  donorProfileId String   @map("donor_profile_id")
  q1Score        Int      @map("q1_score")  // 0-3
  q2Score        Int      @map("q2_score")  // 0-3
  totalScore     Int      @map("total_score")
  isEscalated    Boolean  @default(false) @map("is_escalated")
  week           CheckinWeek? @map("checkin_week")
  completedAt    DateTime @default(now()) @map("completed_at")

  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])
  escalation     SafetyEscalation?

  @@map("phq2_responses")
}

model LifeAfterReminder {
  id             String      @id @default(uuid())
  donorProfileId String      @map("donor_profile_id")
  week           CheckinWeek
  dueAt          DateTime    @map("due_at")
  sentAt         DateTime?   @map("sent_at")
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id])
  @@unique([donorProfileId, week])
  @@index([dueAt, sentAt])
  @@map("life_after_reminders")
}

model SafetyEscalation {
  id                String   @id @default(uuid())
  phq2ResponseId    String   @unique @map("phq2_response_id")
  status            String   @default("OPEN") // OPEN, ACKNOWLEDGED, CLOSED
  acknowledgedAt    DateTime? @map("acknowledged_at")
  acknowledgedById  String?  @map("acknowledged_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  phq2Response      PHQ2Response @relation(fields: [phq2ResponseId], references: [id])

  @@map("safety_escalations")
}

// ─── SHARED ───────────────────────────────────────────────────────────────────

model ForumPost {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  category  String
  title     String
  content   String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author    User @relation(fields: [authorId], references: [id])

  @@map("forum_posts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    // checkin_due, stalled_eval, message_received, goal_milestone
  title     String
  body      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─── AUDIT LOG (append-only) ──────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String   // READ, CREATE, UPDATE, DELETE
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json     @default("{}")
  timestamp    DateTime @default(now())

  user         User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
